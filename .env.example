# Server-side only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public Supabase Auth client values (safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Prisma Spectrum API origin. Kept server-side; this site proxies requests.
SPECTRUM_API_URL=https://your-spectrum-api.example.com

# Configure to the app's verified Universal Link / Android App Link or app scheme
# that opens the Premium screen. Store links remain available if it does not open.
NEXT_PUBLIC_PRISMA_PREMIUM_LINK=
